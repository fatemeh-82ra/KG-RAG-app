# Copy this file to `.env` and fill in what you have.
# NEVER put real keys in this file - only in `.env` (which is gitignored).

# --- Chat + Embedding providers (any one is enough for chat) ---
GOOGLE_API_KEY=
NVIDIA_API_KEY=

# --- Neo4j (required) ---
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
